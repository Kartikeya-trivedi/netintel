# Copy to backend/.env and adjust. Never commit a real .env.

# --- Persistence -------------------------------------------------------------
# Defaults to a SQLite file next to the backend package.
# DATABASE_URL=sqlite:///./netintel.db

# --- NLP ---------------------------------------------------------------------
# Download with: uv run python -m spacy download en_core_web_lg
SPACY_MODEL=en_core_web_lg

# --- Optional LLM-assisted extraction ---------------------------------------
# When false (the default) NetIntel uses rule-based extraction only and needs
# no API key. Enabling this improves relation quality but is never required.
USE_LLM_EXTRACTION=false
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Anomaly detection thresholds -------------------------------------------
TXN_SPIKE_ZSCORE=3.0
STRUCTURING_THRESHOLD=50000
STRUCTURING_WINDOW_DAYS=7
STRUCTURING_MIN_COUNT=3

# --- Graph guard -------------------------------------------------------------
MAX_GRAPH_NODES=500
